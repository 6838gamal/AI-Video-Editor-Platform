# Application
APP_NAME=Video Editor
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/video_editor

# Security
SECRET_KEY=dev-secret-key
SESSION_SECRET=dev-session-secret

# Storage
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600

# Tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YT_DLP_PATH=yt-dlp

# AI (optional)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Fallback user
ALLOW_FALLBACK_USER=true
